#!/bin/sh
# ============================================================
# Maven Wrapper — Space Mission API
# Baixa o Maven automaticamente se necessário (macOS/Linux)
# ============================================================

MAVEN_VERSION="3.9.6"
MAVEN_HOME="$HOME/.mvn-wrapper/apache-maven-$MAVEN_VERSION"
MAVEN_ZIP_URL="https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/$MAVEN_VERSION/apache-maven-$MAVEN_VERSION-bin.zip"
MAVEN_ZIP="$HOME/.mvn-wrapper/apache-maven-$MAVEN_VERSION-bin.zip"

# Detecta JAVA_HOME
if [ -z "$JAVA_HOME" ]; then
  if /usr/libexec/java_home > /dev/null 2>&1; then
    JAVA_HOME=$(/usr/libexec/java_home)
    export JAVA_HOME
  fi
fi

JAVACMD="${JAVA_HOME:-}/bin/java"
if [ -z "$JAVA_HOME" ]; then
  JAVACMD="java"
fi

# Baixa Maven se não instalado localmente
if [ ! -d "$MAVEN_HOME" ]; then
  echo "Maven $MAVEN_VERSION não encontrado. Baixando..."
  mkdir -p "$HOME/.mvn-wrapper"
  if command -v curl > /dev/null 2>&1; then
    curl -fsSL -o "$MAVEN_ZIP" "$MAVEN_ZIP_URL"
  elif command -v wget > /dev/null 2>&1; then
    wget -q -O "$MAVEN_ZIP" "$MAVEN_ZIP_URL"
  else
    echo "ERRO: Instale curl ou wget, ou instale o Maven manualmente."
    echo "  macOS: brew install maven"
    exit 1
  fi
  echo "Extraindo Maven..."
  unzip -q "$MAVEN_ZIP" -d "$HOME/.mvn-wrapper/"
  rm -f "$MAVEN_ZIP"
  echo "Maven $MAVEN_VERSION pronto."
fi

exec "$MAVEN_HOME/bin/mvn" "$@"
